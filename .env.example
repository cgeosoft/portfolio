# Required. WEBPAGE_URL, WEBPAGE_EMAIL, and POSTHOG_API_KEY are baked into the
# bundle at build time and have no fallback: a blank value fails the build.

# Webpage URL for terms and external marketing site
WEBPAGE_URL=http://localhost:3000

# Developer contact address shown in the sponsorship dialog
WEBPAGE_EMAIL=""

# GitHub repository URL for releases, issues, and source code
GITHUB_URL="https://github.com/cgeosoft/portfolio"

# Cloudflare Pages project name for website deployment
CLOUDFLARE_PAGES_PROJECT="portfolio"

# PostHog API key for anonymous telemetry
POSTHOG_API_KEY=

# Optional OpenAI-compatible model used to generate release changelog entries.
# The release script reads these from .env and summarizes the git diff between
# the previous release and the new release. If unset, a plain git log based
# entry is written instead and the release still proceeds.
OPENAI_API_TOKEN=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
