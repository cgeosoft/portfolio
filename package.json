{
  "name": "portfolio",
  "version": "0.2.0",
  "author": "Christos Georgiou <christos@cgeosoft.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/setup-dev-icon.sh && bun run build:metrics && bun run build:css && bunx electrobun dev",
    "setup:desktop": "bash scripts/setup-dev-icon.sh",
    "build:metrics": "bun run scripts/build-metrics.ts",
    "check:metrics": "bun run scripts/build-metrics.ts --check",
    "build:metrics-site": "bun run scripts/build-metrics-site.ts",
    "build:css": "tailwindcss -i src/views/src/input.css -o src/views/style.css --minify",
    "watch:css": "tailwindcss -i src/views/src/input.css -o src/views/style.css --watch",
    "build": "bun run build:metrics && bun run build:css && bunx electrobun build",
    "typecheck": "bun run build:metrics && tsc --noEmit && tsc --project src/views/tsconfig.json --noEmit",
    "test": "bun run build:metrics && bun test",
    "release": "bash scripts/release.sh tag",
    "release:local": "bash scripts/release.sh local",
    "release:deb": "bash scripts/release.sh debian",
    "release:win": "bash scripts/release.sh windows",
    "release:mac": "bash scripts/release.sh macos",
    "package:deb": "bash scripts/build-deb.sh"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.26.0",
    "posthog-node": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "assemblyscript": "0.28.20",
    "bun-types": "^1.3.14",
    "electrobun": "^2.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
