{
  "name": "portfolio",
  "version": "0.15.0",
  "author": "Christos Georgiou <christos@cgeosoft.com>",
  "private": true,
  "type": "module",
  "workspaces": [
    "modules/shared",
    "modules/service",
    "modules/gui",
    "modules/desktop"
  ],
  "scripts": {
    "start": "bun run --cwd modules/desktop start",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun run test:metrics && bun --filter portfolio-shared --filter portfolio-service --filter portfolio-gui --filter portfolio-desktop test",
    "test:metrics": "bun test ./extras/metrics",
    "build": "bun run --cwd modules/desktop build",
    "build:metrics": "bun run scripts/build-metrics.ts",
    "release": "bash scripts/release.sh release",
    "release:build": "bash scripts/release.sh build",
    "website:start": "bun run --cwd extras/website dev",
    "website:metrics": "bun run scripts/build-metrics-site.ts",
    "website:screenshots": "bun run scripts/screenshots/capture.ts",
    "website:publish": "bash scripts/release.sh publish-website"
  },
  "devDependencies": {
    "assemblyscript": "0.28.20",
    "bun-types": "^1.4.4",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.153.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "postcss-selector-parser": "^7.1.6",
    "source-map-js": "^1.2.2",
    "follow-redirects": "^1.16.1",
    "undici": "^7.30.1"
  }
}
