{
  "name": "portfolio-desktop",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "stage": "bun run scripts/stage.ts",
    "start": "HUTCH_HOME=$PWD/.hutch/home electrobun dev",
    "build": "bun run stage && HUTCH_HOME=$PWD/.hutch/home electrobun build --env=stable",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "electrobun": "^2.0.1",
    "typescript": "^5.7.3"
  }
}
