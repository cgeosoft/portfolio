{
  "name": "portfolio-service",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir dist-bundle --outfile main.js",
    "bundle": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "portfolio-shared": "workspace:*",
    "posthog-node": "^4.0.0"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "bun-types": "^1.3.14",
    "typescript": "^5.7.3"
  }
}
